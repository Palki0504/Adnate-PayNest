# Server configuration template for Adnate PayNest.
# Copy this file to .env locally and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# Frontend / CORS
# Production example: CLIENT_URL=https://your-netlify-site.netlify.app
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# MongoDB
# Production must use your hosted MongoDB Atlas connection string.
MONGO_URI=mongodb://localhost:27017/adnate_paynest

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Email delivery
# Gmail requires a Google App Password, not your normal Gmail password.
# For Gmail:
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-gmail-address@gmail.com
# EMAIL_PASS=your-16-character-google-app-password
#
# Gmail API over HTTPS avoids SMTP timeouts on some hosts:
# EMAIL_SERVICE=gmail_api
# EMAIL_FROM=your-gmail-address@gmail.com
# GMAIL_USER=your-gmail-address@gmail.com
# GMAIL_CLIENT_ID=your-google-oauth-client-id
# GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
# GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
#
# For SMTP providers:
# EMAIL_SERVICE=smtp
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
#
# If Gmail SMTP times out on Render, use Brevo transactional email over HTTPS:
# EMAIL_SERVICE=brevo
# EMAIL_USER=your-verified-sender@example.com
# BREVO_API_KEY=your-brevo-api-key
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=replace-with-sender-email
EMAIL_PASS=replace-with-email-app-password

# Seed-only demo accounts. Required only when running npm run seed.
SEED_CUSTOMER_EMAIL=customer@paynest.test
SEED_CUSTOMER_PASSWORD=replace-with-demo-customer-password
SEED_CUSTOMER_2_EMAIL=beneficiary@paynest.test
SEED_CUSTOMER_2_PASSWORD=replace-with-demo-beneficiary-password
SEED_MANAGER_EMAIL=manager@paynest.test
SEED_MANAGER_PASSWORD=replace-with-demo-manager-password
SEED_ADMIN_EMAIL=admin@paynest.test
SEED_ADMIN_PASSWORD=replace-with-demo-admin-password
