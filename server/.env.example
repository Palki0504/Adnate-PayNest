# Server configuration template for Adnate PayNest.
# Copy this file to .env locally and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/adnate_paynest

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Email delivery
# EMAIL_SERVICE can be gmail or smtp.
EMAIL_SERVICE=smtp
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=replace-with-email-username
EMAIL_PASS=replace-with-email-password

# Seed-only demo accounts. Required only when running npm run seed.
SEED_CUSTOMER_EMAIL=customer@paynest.test
SEED_CUSTOMER_PASSWORD=replace-with-demo-customer-password
SEED_CUSTOMER_2_EMAIL=beneficiary@paynest.test
SEED_CUSTOMER_2_PASSWORD=replace-with-demo-beneficiary-password
SEED_MANAGER_EMAIL=manager@paynest.test
SEED_MANAGER_PASSWORD=replace-with-demo-manager-password
SEED_ADMIN_EMAIL=admin@paynest.test
SEED_ADMIN_PASSWORD=replace-with-demo-admin-password

